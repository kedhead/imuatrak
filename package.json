{
  "name": "imuatrak",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "jest",
    "check:ota": "node scripts/check-ota-runtime.mjs",
    "predeploy:ota": "npm run check:ota",
    "deploy:ota": "eas update --environment production --channel production",
    "deploy:ota:rollback": "eas update:roll-back-to-embedded --branch production",
    "deploy:rules": "cd firebase && firebase deploy --only firestore:rules",
    "deploy:storage": "cd firebase && firebase deploy --only storage",
    "deploy:functions": "cd firebase && firebase deploy --only functions",
    "build:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit -p ios --latest --profile production",
    "build:android": "eas build --profile production --platform android",
    "submit:android": "eas submit -p android --latest --profile production"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/vector-icons": "^15.1.1",
    "@imuatrak/watch-bridge": "file:./modules/watch-bridge",
    "@imuatrak/wear-bridge": "file:./modules/wear-bridge",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~58.0.16",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.13",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-media-library": "58.0.11",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-tracking-transparency": "~58.0.2",
    "expo-updates": "~58.0.17",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "firebase": "^11.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-manager": "12.5.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.3.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-purchases": "^10.15.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "~8.57.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3"
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isClubMember(clubId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }

    function getClubMember(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data;
    }

    function hasClubRole(clubId, roles) {
      return isClubMember(clubId) && getClubMember(clubId).role in roles;
    }

    // ── User sessions (private) ──────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      match /channelPreferences/{channelId} {
        allow read, write: if isOwner(uid);
      }

      // Per-thread DM read state. Kept in the reader's own document rather
      // than on the shared thread, so neither participant can write the
      // other's read marker.
      match /dmThreads/{threadId} {
        allow read, write: if isOwner(uid);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.userId == uid
          && request.resource.data.schemaVersion is int;

        allow update: if isOwner(uid)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.schemaVersion == resource.data.schemaVersion;

        allow delete: if isOwner(uid);
      }
    }

    // Public-shared sessions (powers imuatrak.app/s/{id}). The phone app
    // writes a denormalized copy here when the user toggles "Share
    // publicly" on, and deletes it when they toggle it off.
    //
    // Anyone can read, only the original owner can write.
    match /publicSessions/{sessionId} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isPublic == true;

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── User → club membership index ─────────────────────────────────────────
    match /userClubs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── App admins ───────────────────────────────────────────────────────────
    // Grants access to the app-analytics admin page (imuatrak.app/dashboard/
    // admin). Docs are created manually in the Firebase console: doc ID = the
    // admin's Auth UID. A user may check their OWN admin status so the web
    // dashboard knows whether to show the page; the getAppStats Cloud Function
    // re-checks server-side, so this read is a UI hint, not the gate.
    // ── Direct messages ──────────────────────────────────────────────────────
    //
    // Deliberately NOT modelled as a two-person private channel: the channel
    // rule grants club owners/admins read access for moderation, which applied
    // to DMs would let them read their members' private messages. Only the two
    // participants can read or write here — there is no admin bypass, by
    // design. Changing that would need a privacy-policy update, not just a rule
    // edit.
    match /dms/{threadId} {
      function isParticipant() {
        return isSignedIn()
          && request.auth.uid in resource.data.participants;
      }

      allow read: if isParticipant();
      // Created by the openDmThread Cloud Function, which checks the two share
      // a club — clients can't mint a thread with anyone they like.
      allow create: if false;
      allow delete: if false;
      // Participants keep the thread's preview fields current when they send.
      // Nothing else, so neither can rewrite who the participants are.
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["lastMessageAt", "lastMessagePreview"]);

      match /messages/{messageId} {
        function inThread() {
          return isSignedIn()
            && request.auth.uid in
               get(/databases/$(database)/documents/dms/$(threadId)).data.participants;
        }

        allow read: if inThread();
        allow create: if inThread()
          && request.resource.data.authorId == request.auth.uid;
        // Your own messages only — no moderator delete in a private thread.
        allow delete: if inThread() && resource.data.authorId == request.auth.uid;
        allow update: if inThread()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]);
      }
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false; // console / Admin SDK only
    }

    // ── Invite tokens (created by Cloud Functions) ───────────────────────────
    // Tokens are secret capabilities: a signed-in user who KNOWS a token may
    // fetch it (join flow does a direct doc get), but nobody may list the
    // collection — otherwise any user could enumerate tokens and self-join
    // every club.
    match /clubInvites/{token} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false; // Cloud Functions only
    }

    // ── Clubs ────────────────────────────────────────────────────────────────
    match /clubs/{clubId} {
      // The club document holds only non-sensitive metadata (name, logo,
      // location, member count). It is publicly readable so invite links and
      // the imuatrak.app/join landing page can show which club you're joining
      // before sign-in. All sub-collections below keep their stricter rules.
      allow read: if true;
      // Owners/admins can edit the club. memberCount is maintained solely by
      // the onMemberJoin/onMemberLeave Cloud Function triggers (Admin SDK
      // bypasses rules), so clients get no counter carve-out — it allowed any
      // signed-in user to set an arbitrary count on any club.
      // Subscription fields are billing state (they gate ads and channel
      // limits) and may only change server-side: the expireClubTrials sweep
      // and any future billing webhook, both via the Admin SDK.
      allow update: if hasClubRole(clubId, ["owner", "admin"])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ["subscriptionStatus", "subscriptionTier", "trialEndsAt", "subscriptionRenewsAt"]
        );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if hasClubRole(clubId, ["owner"]);

      // ── Members ────────────────────────────────────────────────────────────
      match /members/{uid} {
        // A member can read the roster; anyone may read THEIR OWN member doc
        // even before joining, so the join flow's "am I already a member?"
        // existence check isn't denied for a brand-new joiner. isOwner(uid)
        // restricts this to the caller's own doc — no enumerating others.
        allow read: if isClubMember(clubId) || isOwner(uid);
        // Users can create/delete their own membership (join via invite, leave).
        allow create, delete: if isOwner(uid) || hasClubRole(clubId, ["owner", "admin"]);
        // Owners/admins can update any member (e.g. change role). A member may
        // update THEIR OWN doc only for profile fields (displayName/avatarUrl) —
        // role and uid must be unchanged, so they can't self-promote.
        allow update: if hasClubRole(clubId, ["owner", "admin"])
          || (isOwner(uid)
              && request.resource.data.role == resource.data.role
              && request.resource.data.uid == resource.data.uid);
      }

      // ── Events ─────────────────────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isClubMember(clubId);
        allow create: if hasClubRole(clubId, ["owner", "admin", "coach"]);
        // Event details (time, location, capacity, boat lineups) stay
        // staff-only, but ANY member must be able to RSVP — and RSVPs live in
        // the event doc's `rsvps` array (which also carries registered guest
        // paddlers). Without this carve-out a plain "member" could not RSVP at
        // all. Rules can't verify that a member only touched their own entry
        // in an array, so this trusts club members not to edit each other's
        // RSVPs; that matches the trust already granted elsewhere in a club
        // (posting, commenting, chat). Moving RSVPs to a per-user
        // subcollection is the stricter fix if that ever becomes a problem.
        allow update: if hasClubRole(clubId, ["owner", "admin", "coach"])
          || (isClubMember(clubId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rsvps"]));
        allow delete: if hasClubRole(clubId, ["owner", "admin"]);
      }

      // ── Legacy chat messages (kept readable during migration) ─────────────
      match /messages/{messageId} {
        allow read: if isClubMember(clubId);
        allow create, update: if false;
        allow delete: if isClubMember(clubId)
          && (resource.data.authorId == request.auth.uid
              || hasClubRole(clubId, ["owner", "admin"]));
      }

      // ── Channels ───────────────────────────────────────────────────────────
      match /channels/{channelId} {
        function isChannelMember() {
          let ch = get(/databases/$(database)/documents/clubs/$(clubId)/channels/$(channelId)).data;
          return !ch.isPrivate
            ? isClubMember(clubId)
            : (isClubMember(clubId) && request.auth.uid in ch.memberIds)
              || hasClubRole(clubId, ["owner", "admin"]);
        }

        // All club members can see the channel list (name/icon/isPrivate)
        allow read: if isClubMember(clubId);
        // Channel creation goes through Cloud Function (Admin SDK) — deny direct writes
        allow create: if false;
        allow update, delete: if hasClubRole(clubId, ["owner", "admin"]);

        match /messages/{messageId} {
          allow read: if isChannelMember();
          allow create: if isChannelMember()
            && request.resource.data.authorId == request.auth.uid;
          allow delete: if isChannelMember()
            && (resource.data.authorId == request.auth.uid
                || hasClubRole(clubId, ["owner", "admin"]));
          // Members may toggle emoji reactions — and touch NOTHING else on the
          // message (same affectedKeys pattern as poll votes on posts).
          // Owners/admins may additionally pin, again touching nothing else, so
          // a pin can't smuggle an edit into someone else's message.
          allow update: if (isChannelMember()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]))
            || (hasClubRole(clubId, ["owner", "admin"])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinnedAt", "pinnedBy"]));
        }
      }

      // ── Posts ──────────────────────────────────────────────────────────────
      match /posts/{postId} {
        allow read: if isClubMember(clubId);
        // The feed is an announcements board — only staff start threads. Any
        // member can still read, like, comment, and vote in polls (see the
        // update carve-out below and the comments rules). The app hides the
        // composer for members; this is the half that actually enforces it.
        allow create: if hasClubRole(clubId, ["owner", "admin", "coach"])
          && request.resource.data.authorId == request.auth.uid;
        // Engagement lives ON the post doc — toggleLike writes likedBy and
        // likeCount, addComment bumps commentCount — so members need these
        // narrow carve-outs to like or comment on a post they didn't write.
        // Without them, restricting authorship to staff would have silently
        // broken liking and commenting for every ordinary member.
        allow update: if isClubMember(clubId)
          && (resource.data.authorId == request.auth.uid
              || hasClubRole(clubId, ["owner", "admin"])
              || request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["likedBy", "likeCount"])
              || request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["commentCount"])
              || (resource.data.type == "poll"
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pollVotes"])));
        allow delete: if isClubMember(clubId)
          && (resource.data.authorId == request.auth.uid
              || hasClubRole(clubId, ["owner", "admin"]));

        // ── Comments ─────────────────────────────────────────────────────────
        match /comments/{commentId} {
          allow read: if isClubMember(clubId);
          allow create: if isClubMember(clubId)
            && request.resource.data.authorId == request.auth.uid;
          allow update: if isClubMember(clubId)
            && resource.data.authorId == request.auth.uid;
          allow delete: if isClubMember(clubId)
            && (resource.data.authorId == request.auth.uid
                || hasClubRole(clubId, ["owner", "admin"]));
        }
      }
    }
  }
}

# Firebase web-app config — same values as the mobile app's .env, just
# with NEXT_PUBLIC_ prefix instead of EXPO_PUBLIC_. These are public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase App Check (optional). A reCAPTCHA v3 site key, registered under
# Firebase console > App Check > Apps > the web app. Leave blank to disable —
# lib/appCheck.ts no-ops without it.
#
# v3, not Enterprise: v3 is free, Enterprise bills per assessment.
# Do NOT enable App Check ENFORCEMENT while this is the only client that can
# attest — it would block the phone app outright. See docs/cost-controls.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
